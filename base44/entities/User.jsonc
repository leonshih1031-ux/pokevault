{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "public_profile": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user's binder is viewable via the public share link"
    },
    "display_name": {
      "type": "string",
      "description": "Name shown on the public binder profile"
    },
    "bio": {
      "type": "string",
      "description": "Short bio shown on the public binder profile"
    },
    "seller_stripe_account_id": {
      "type": "string",
      "description": "Stripe Connect Express account ID for marketplace payouts"
    },
    "country": {
      "type": "string",
      "description": "User's country for shipping and selling"
    },
    "address_line": {
      "type": "string",
      "description": "Street address for shipping"
    },
    "city": {
      "type": "string",
      "description": "City for shipping"
    },
    "state_region": {
      "type": "string",
      "description": "State or region for shipping"
    },
    "postal_code": {
      "type": "string",
      "description": "Postal/ZIP code for shipping"
    },
    "phone": {
      "type": "string",
      "description": "Phone number for shipping contact"
    }
  },
  "required": [
