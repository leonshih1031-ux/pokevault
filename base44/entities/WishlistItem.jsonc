{
  "name": "WishlistItem",
  "type": "object",
  "properties": {
    "card_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "set_id": {
      "type": "string"
    },
    "set_name": {
      "type": "string"
    },
    "number": {
      "type": "string"
    },
    "image_small": {
      "type": "string"
    },
    "image_large": {
      "type": "string"
    },
    "rarity": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "default": "Medium"
    },
    "target_price": {
      "type": "number"
    },
    "list_type": {
      "type": "string",
      "enum": [
        "wishlist",
        "trade"
      ],
      "default": "wishlist"
    },
    "asking_price": {
      "type": "number"
    },
    "condition": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "card_id",
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}