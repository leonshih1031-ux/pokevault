{
  "name": "CardPriceHistory",
  "type": "object",
  "properties": {
    "card_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "image_small": {
      "type": "string"
    },
    "set_id": {
      "type": "string"
    },
    "set_name": {
      "type": "string"
    },
    "rarity": {
      "type": "string",
      "description": "TCG API rarity string at snapshot time (e.g. Double Rare, Ultra Rare, Illustration Rare)."
    },
    "price": {
      "type": "number"
    },
    "pct_30d": {
      "type": "number",
      "description": "Percent change of cardmarket price over the trailing 30 days, computed from cardmarket rolling averages at snapshot time."
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "card_id",
    "snapshot_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}